// GPU version of explorer.go: keep them in step.

func dist(p vec3) float {
	csize := vec3(1, 1, 1.3)
	p = p.xzy
	scale := 1.0
	for i := 0; i < 12; i++ {
		p = 2*clamp(p, -csize, csize) - p
		r2 := dot(p, p+sin(p.z*0.3*(0.5+0.5*sin(Time))))
		k := max(2/r2, 0.027)
		p *= k
		scale *= k
	}
	l := length(p.xy)
	rxy := l - 1.2 + 0.2*sin(Time)
	n := l * p.z
	rxy = max(rxy, -n/4)
	return rxy / abs(scale)
}

func hash(p vec2) float {
	p3 := fract(p.xyx * vec3(0.1031, 0.11369, 0.13787))
	p3 += dot(p3, p3.yzx+19.19)
	return fract((p3.x + p3.y) * p3.z)
}

func sphereRadius(t float) float {
	t = t * 0.01 * (400 / Resolution.y)
	return t*t + 0.005
}

func normalAt(p vec3, r float) vec3 {
	e := r * 0.5
	return normalize(vec3(
		dist(p+vec3(e, 0, 0))-dist(p-vec3(e, 0, 0)),
		dist(p+vec3(0, e, 0))-dist(p-vec3(0, e, 0)),
		dist(p+vec3(0, 0, e))-dist(p-vec3(0, 0, e)),
	))
}

func shadow(ro, rd vec3) float {
	res := 1.0
	s := 0.05
	for i := 0; i < 15; i++ {
		h := dist(ro + rd*s)
		res = min(5*h/s, res)
		s += h + 0.01
	}
	return max(res, 0)
}

func lighting(mat, normal, eyeDir vec3, d, sh float) vec3 {
	sun := normalize(vec3(0.4, 0.4, 0.3))
	warm := vec3(1, 0.9, 0.85)
	col := mat * warm * max(dot(sun, normal), 0) * sh
	r := reflect(eyeDir, normal)
	col += pow(max(dot(sun, r), 0), 12) * warm * 0.5 * sh
	col += mat * 0.2 * max(r.y, 0.2)
	return mix(vec3(0.15, 0.15, 0.17), col, min(exp(-d*d*0.015), 1))
}

func postEffects(rgb vec3, xy vec2) vec3 {
	rgb = pow(rgb, vec3(0.45))
	rgb = mix(vec3(0.5), mix(vec3(dot(vec3(0.2125, 0.7154, 0.0721), rgb*1.3)), rgb*1.3, 1.3), 1.4)
	rgb *= 0.4 + 0.6*pow(180*xy.x*xy.y*(1-xy.x)*(1-xy.y), 0.35)
	return clamp(rgb, 0, 1)
}

// pick returns element k of the eight values in a and b.
func pick(a, b vec4, k int) float {
	v := a
	if k >= 4 {
		v = b
		k -= 4
	}
	if k == 0 {
		return v.x
	} else if k == 1 {
		return v.y
	} else if k == 2 {
		return v.z
	}
	return v.w
}

// put returns a and b with element k set to x.
func put(a, b vec4, k int, x float) (vec4, vec4) {
	if k == 0 {
		a.x = x
	} else if k == 1 {
		a.y = x
	} else if k == 2 {
		a.z = x
	} else if k == 3 {
		a.w = x
	} else if k == 4 {
		b.x = x
	} else if k == 5 {
		b.y = x
	} else if k == 6 {
		b.z = x
	} else {
		b.w = x
	}
	return a, b
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	frag := fragCoord(dstPos)
	rd := camRay(frag)
	ro := CamPos

	// The first eight near misses: distances along the ray, and estimates.
	ta := vec4(0)
	tb := vec4(0)
	ea := vec4(0)
	eb := vec4(0)
	n := 0
	t := 0.05 * hash(frag)
	for j := 0; j < 120; j++ {
		if n >= 8 || t > 14 {
			break
		}
		de := dist(ro + rd*t)
		if de < sphereRadius(t) {
			ta, tb = put(ta, tb, n, t)
			ea, eb = put(ea, eb, n, de-0.001)
			n++
		}
		t += de
	}

	col := vec3(0)
	alphaAcc := 0.0
	if n > 0 {
		sha := shadow(ro+rd*pick(ta, tb, n-1), vec3(0.4, 0.4, 0.3))
		for i := 0; i < 8; i++ {
			if i >= n {
				break
			}
			d := pick(ta, tb, i)
			r := sphereRadius(d)
			alpha := (1 - alphaAcc) * min((r-pick(ea, eb, i))/r, 1)
			pos := ro + rd*d
			nrm := normalAt(pos, r)
			alb := CamFwd/10 + normalize(pos.yzx)/10*vec3(0.4, 0.2, 0.2)
			col += lighting(alb, nrm, rd, d, sha) * alpha
			alphaAcc += alpha
		}
	}
	col += vec3(0.15, 0.15, 0.17) * clamp(1-alphaAcc, 0, 1)
	return vec4(postEffects(col, frag/Resolution)*smoothstep(0, 2, Time), 1)
}
