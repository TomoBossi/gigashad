// GPU version of gopher.go: keep them in step.

func rot(v vec2, a float) vec2 {
	s := sin(a)
	c := cos(a)
	return vec2(v.x*c-v.y*s, v.x*s+v.y*c)
}

func repeat(p vec3, spacing float) vec3 {
	return mod(p+0.5*spacing, spacing) - 0.5*spacing
}

func smin(a, b, k float) float {
	h := max(k-abs(a-b), 0) / k
	return min(a, b) - h*h*h*k/6
}

func sdEllipsoid(p, r vec3) float {
	k0 := length(p / r)
	k1 := length(p / (r * r))
	return k0 * (k0 - 1) / k1
}

func sdStick(p, a, b vec3, r1, r2 float) float {
	pa := p - a
	ba := b - a
	h := clamp(dot(pa, ba)/dot(ba, ba), 0, 1)
	return length(pa-ba*h) - mix(r1, r2, h*h*(3-2*h))
}

func sdBox(p, b vec3) float {
	q := abs(p) - b
	return length(max(q, 0)) + min(max(q.x, max(q.y, q.z)), 0)
}

func sdTorus(p vec3, r, t float) float {
	return length(vec2(length(p.xz)-r, p.y)) - t
}

func sdCappedCylinder(p vec3, h, r float) float {
	d := abs(vec2(length(p.xz), p.y)) - vec2(h, r)
	return min(max(d.x, d.y), 0) + length(max(d, 0))
}

func sdEar(p vec3) float {
	p.xz = rot(p.xz, 1.6)
	q := p.yxz
	return min(sdTorus(q, 0.15, 0.05), sdCappedCylinder(q-vec3(0, -0.025, 0), 0.15, 0.025))
}

func sdFoot(p vec3) float {
	a := vec3(0.6, -0.5, -0.1)
	return min(sdStick(p, a, a-vec3(0.1, 0.07, 0.4), 0.15, 0.1), sdStick(p, a, a-vec3(0, 0.07, 0.4), 0.15, 0.1))
}

// distMat is the distance to the nearest gopher and its material there.
func distMat(p vec3) (float, float) {
	p = repeat(p, 5)
	alpha := sin(Time) / 10
	alphaBody := sin(Time-1) / 10

	body := p
	body.zy = rot(body.zy, alphaBody)
	dBody := sdEllipsoid(body-vec3(0, -1, 0), vec3(0.65, 0.5, 0.5))

	p = p - vec3(0, -0.5, 0)
	p.zy = rot(p.zy, alpha)
	p = p + vec3(0, -0.5, 0)

	dHead := sdEllipsoid(p, vec3(0.65, 0.5, 0.5))
	dBodyHead := smin(dHead, dBody, 1.5)

	np := p - vec3(0, -0.20, -0.56)
	c := cos(-2 * np.x)
	s := sin(-2 * np.x)
	np.xy = vec2(c*np.x+s*np.y, -s*np.x+c*np.y)
	np.x -= clamp(np.x, -0.1, 0.1)
	dNose := length(np) - 0.08

	dTruffle := sdEllipsoid(p-vec3(0, -0.15, -0.61), vec3(0.07, 0.05, 0.05))

	arm := body
	arm.x = abs(arm.x)
	a := vec3(0.6, -0.5, -0.1)
	dArm := sdStick(arm, a, a-vec3(-0.3, 0.3, 0), 0.1, 0.15)

	p.x = abs(p.x)
	dTeeth := sdBox(p-vec3(0.050, -0.30, -0.57), vec3(0.03, 0.06, 0.006)) - 0.02
	dEar := sdEar(p - vec3(0.50, 0.30, 0.15))
	dEyeW := length(p-vec3(0.3, 0, -0.4)) - 0.25
	dEyeB := length(p-vec3(0.3, 0, -0.46)) - 0.20

	foot := body
	foot.x = abs(foot.x)
	dFoot := sdFoot(foot - vec3(-0.25, -0.95, 0.25))

	d := min(dBodyHead, min(dEyeW, min(dEyeB, min(dEar, min(dNose, min(dTruffle, min(dTeeth, min(dArm, dFoot))))))))
	m := 0.0
	if dEyeW == d {
		m = 1
	}
	if dEyeB == d {
		m = 3
	}
	if dBodyHead == d {
		m = 4
	}
	if dEar == d {
		m = 4
	}
	if dNose == d {
		m = 5
	}
	if dTruffle == d {
		m = 3
	}
	if dTeeth == d {
		m = 1
	}
	if dArm == d {
		m = 4
	}
	if dFoot == d {
		m = 5
	}
	return d, m
}

func dist(p vec3) float {
	d, _ := distMat(p)
	return d
}

func normalAt(p vec3) vec3 {
	d := dist(p)
	e := 0.001
	return normalize(d - vec3(dist(p-vec3(e, 0, 0)), dist(p-vec3(0, e, 0)), dist(p-vec3(0, 0, e))))
}

func occlusion(p, n vec3) float {
	occ := 0.0
	sca := 1.0
	for i := 0; i < 5; i++ {
		h := 0.01 + 0.11*float(i)/4
		occ += (h - dist(p+h*n)) * sca
		sca *= 0.95
	}
	return clamp(1-2*occ, 0, 1)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	rd := camRay(fragCoord(dstPos))
	ro := CamPos
	col := vec3(0.4, 0.4, 0.9) * (1 - rd.y)

	t := 0.0
	for i := 0; i < 256; i++ {
		ds := dist(ro + rd*t)
		t += ds
		if t > 100 || abs(ds) < 0.001 {
			break
		}
	}

	if t < 100 {
		p := ro + rd*t
		n := normalAt(p)
		_, m := distMat(p)
		if m == 1 {
			col = vec3(0.9)
		} else if m == 3 {
			col = vec3(0.05)
		} else if m == 4 {
			col = vec3(0.1, 0.5, 0.5)
		} else {
			col = vec3(0.8, 0.6, 0.2)
		}
		sunDir := normalize(vec3(4, 4, -3))
		occ := occlusion(p, n)
		sun := clamp(dot(n, sunDir), 0, 1)
		sky := clamp(0.5+0.5*n.y, 0, 1)
		ind := clamp(dot(n, normalize(sunDir*vec3(-1, 0, -1))), 0, 1)
		lin := sun * vec3(1.64, 1.27, 0.99)
		lin += sky * vec3(0.16, 0.20, 0.28) * occ
		lin += ind * vec3(0.40, 0.28, 0.20) * occ
		col = col * lin
	}

	col = pow(col, vec3(0.4545))
	fog := clamp(1-exp(-t*0.1*0.25), 0, 1)
	return vec4(mix(col, vec3(0.95, 0.95, 1.0), fog), 1)
}
